# ---------------------------------------------------------------------------
# Required in production — without these, form submissions fail loudly.
# Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL. Used for OpenGraph, canonical tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://norvian.ai

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Storage bucket for buyer reference uploads. Defaults to rfq-references.
# SUPABASE_UPLOAD_BUCKET=rfq-references

# Email alert on every submission (Resend). Leave unset to disable entirely —
# submissions are still stored either way.
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=Norvian <onboarding@resend.dev>
